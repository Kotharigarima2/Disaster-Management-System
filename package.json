{
  "name": "final-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "frontend": "cd frontend1 && npm start",
    "backend": "cd backend && node server.js",
    "ml1": "cd backend/ml_model && python app.py",
    "ml2": "cd backend/ml_model_2 && python app.py",
    "ml3": "cd backend/ml_model_3 && python app.py",
